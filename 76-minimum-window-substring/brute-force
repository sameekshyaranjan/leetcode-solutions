class Solution {
public:
    string minWindow(string s, string t) {
        int n=s.size();
        int m=t.size();

        int minlen=INT_MAX;
        int sindex=-1;
        
        for(int i=0;i<n;i++){
            unordered_map<int,int>mpp;
            int cnt=0;
            for(int j=0;j<m;j++){
                mpp[t[j]]++;
            }
            
            for(int j=i;j<n;j++){
                if(mpp[s[j]]>0) cnt++;
                mpp[s[j]]--;

                if(cnt==m){
                if(j-i+1<minlen){
                    minlen=j-i+1;
                    sindex=i;
                }
                break;
            }
            }

        }
        if(sindex==-1) return "";
        return s.substr(sindex,minlen);
    }
};
